<?php

/**
 * @file
 * Direct CKEditor 4, CKEditor 5 and TinyMCE integration for the Footnotes module.
 *
 * Does not integrate with the legacy WYSIWYG module.
 */

/**
 * Implements hook_ckeditor_plugins().
 *
 * Register the CKEditor plugin for the CKEditor module.
 */
function footnotes_wysiwyg_ckeditor_plugins() {
  $path = backdrop_get_path('module', 'footnotes_wysiwyg') . '/ckeditor_plugin';
  return array(
    'footnotes' => array(
      'name' => 'footnotes',
      'file' => 'plugin.js',
      'desc' => t('Add Footnotes'),
      'path' => $path,
      'buttons' => array(
        'footnotes' => array(
          'image' => $path . '/images/footnotes.png',
          'label' => 'Footnotes',
        ),
      ),
    ),
  );
}

/**
 * Implements hook_tinymce_external_plugins().
 *
 * Registers the native TinyMCE plugin, without a Backdrop dialog endpoint.
 * The external-plugin definition must be verified against the installed
 * TinyMCE module version before this integration is released.
 */
function footnotes_wysiwyg_tinymce_external_plugins($format) {
  $path = backdrop_get_path('module', 'footnotes_wysiwyg');

  return array(
    'backdropfootnotes' => array(
      'plugin_path' => base_path() . $path . '/tinymce_plugin/plugin.js',
      'icons' => array(
        'backdropfootnotes' => 'backdropfootnotes.svg',
      ),
      'buttons' => array(
        'backdropfootnotes' => array(
          'icon' => 'backdropfootnotes',
          'tooltip' => t('Insert footnote'),
          'required_tags' => array(),
        ),
      ),
    ),
  );
}

/**
 * Implements hook_menu().
 */
function footnotes_wysiwyg_menu() {
  $items['editor/dialog/footnotes/%filter_format'] = array(
    'title' => 'Footnotes',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('footnotes_wysiwyg_footnote_editor_form', 3),
    'access callback' => 'filter_dialog_access',
    'access arguments' => array(3, 'footnotes'),
    'theme callback' => 'ajax_base_page_theme',
    'type' => MENU_CALLBACK,
  );
  return $items;
}

/**
 * Form callback: Displays the existing CKEditor footnote dialog.
 */
function footnotes_wysiwyg_footnote_editor_form($form, &$form_state, $format) {
  $form_state['format'] = $format;
  // Record the dialog selector that needs to be closed if present.
  if (isset($form_state['input']['dialogOptions']['target'])) {
    $form_state['storage']['dialog_selector'] = $form_state['input']['dialogOptions']['target'];
  }

  // Pull in any default values set by the editor.
  $values = array();
  if (isset($form_state['input']['editor_object'])) {
    $values = $form_state['input']['editor_object'];
  }

  // Set the dialog title.
  backdrop_set_title(t('Insert footnote'));

  $form['footnote_text'] = array(
    '#title' => t('Footnote text'),
    '#type' => 'textfield',
    '#default_value' => isset($values['footnote_text']) ? $values['footnote_text'] : '',
    '#parents' => array('attributes', 'footnote_text'),
  );
  $form['footnote_value'] = array(
    '#title' => t('Footnote value'),
    '#type' => 'textfield',
    '#default_value' => isset($values['footnote_value']) ? $values['footnote_value'] : '',
    '#parents' => array('attributes', 'footnote_value'),
  );

  form_load_include($form_state, 'inc', 'filter', 'filter.pages');

  $form['actions']['#type'] = 'actions';
  $form['actions']['submit'] = array(
    '#type' => 'submit',
    '#value' => t('Save'),
    '#ajax' => array(
      'callback' => 'filter_format_editor_dialog_save',
      'event' => 'click',
    ),
  );

  return $form;
}

/**
 * Existing legacy submit callback; retained for compatibility.
 */
function footnotes_filter_format_editor_form_submit($form, &$form_state) {
  $form_state['values']['attributes']['footnote_text'] = $form_state['values']['footnote_text'];
  $form_state['values']['attributes']['footnote_value'] = $form_state['values']['footnote_value'];
}

/**
 * Implements hook_ckeditor_settings_alter().
 */
function footnotes_wysiwyg_ckeditor_settings_alter(&$settings, $format) {
  $link_token = filter_editor_dialog_token($format, 'footnotes');
  $settings['backdrop']['footnotesDialogUrl'] = url('editor/dialog/footnotes/' . $format->format, array('query' => array('token' => $link_token, 'calling_path' => $_GET['q'])));
}

/**
 * Implements hook_ckeditor5_plugins().
 */
function footnotes_wysiwyg_ckeditor5_plugins() {
  $path = backdrop_get_path('module', 'footnotes_wysiwyg');
  return array(
    'backdropFootnotes.Footnotes' => array(
      'library' => array('footnotes_wysiwyg', 'footnotes_wysiwyg.ckeditor5'),
      'buttons' => array(
        'footnotes' => array(
          'label' => t('Insert footnote'),
          'image' => $path . '/ckeditor5_plugin/icons/footnotes.svg',
          'required_html' => array(),
        ),
      ),
    ),
  );
}

/**
 * Implements hook_library_info().
 */
function footnotes_wysiwyg_library_info() {
  $path = backdrop_get_path('module', 'footnotes_wysiwyg');
  return array(
    'footnotes_wysiwyg.ckeditor5' => array(
      'title' => 'Footnotes integration for CKEditor 5',
      'version' => '1.0.0',
      'js' => array(
        $path . '/ckeditor5_plugin/plugin.js' => array('preprocess' => FALSE),
      ),
      'css' => array(
        $path . '/ckeditor5_plugin/dialog.css' => array(),
      ),
      'dependencies' => array(array('ckeditor5', 'ckeditor5')),
    ),
  );
}

/**
 * Implements hook_ckeditor5_config_alter().
 */
function footnotes_wysiwyg_ckeditor5_config_alter(array &$config, $format) {
  $config['backdropFootnotes'] = array(
    'insertLabel' => t('Insert footnote'),
    'textLabel' => t('Footnote text'),
    'valueLabel' => t('Footnote value (optional)'),
    'saveLabel' => t('Insert'),
    'cancelLabel' => t('Cancel'),
    'emptyTextMessage' => t('Enter a footnote text.'),
    'nestedFootnoteMessage' => t('Footnote text must not contain footnote tags.'),
    'invalidValueMessage' => t('The footnote value contains invalid characters.'),
  );
}

/**
 * Implements hook_ckeditor5_upgrade_button_mapping().
 */
function footnotes_wysiwyg_ckeditor5_upgrade_button_mapping() {
  return array('footnotes' => 'footnotes');
}
