<?php

/**
 * @file
 * Direct CKEditor 4, CKEditor 5 and TinyMCE integration for Footnotes.
 */

/**
 * Returns the single local SVG source used by all editor integrations.
 */
function _footnotes_wysiwyg_icon_path() {
  return backdrop_get_path('module', 'footnotes_wysiwyg') . '/tinymce_plugin/icons/footnotes.svg';
}

/**
 * Builds the token-protected editor dialog URL for a text format.
 */
function _footnotes_wysiwyg_dialog_url($format) {
  $query = array('token' => filter_editor_dialog_token($format, 'footnotes'));
  if (isset($_GET['q'])) {
    $query['calling_path'] = $_GET['q'];
  }
  return url('editor/dialog/footnotes/' . $format->format, array('query' => $query));
}

/**
 * Implements hook_ckeditor_plugins().
 */
function footnotes_wysiwyg_ckeditor_plugins() {
  $path = backdrop_get_path('module', 'footnotes_wysiwyg') . '/ckeditor_plugin';
  return array(
    'footnotes' => array(
      'name' => 'footnotes',
      'file' => 'plugin.js',
      'desc' => t('Insert footnote'),
      'path' => $path,
      'buttons' => array(
        'footnotes' => array(
          'image' => _footnotes_wysiwyg_icon_path(),
          'label' => t('Insert footnote'),
        ),
      ),
    ),
  );
}

/**
 * Implements hook_ckeditor_settings_alter().
 */
function footnotes_wysiwyg_ckeditor_settings_alter(&$settings, $format) {
  $settings['backdrop']['footnotesDialogUrl'] = _footnotes_wysiwyg_dialog_url($format);
  $settings['backdrop']['footnotesIconUrl'] = base_path() . _footnotes_wysiwyg_icon_path();
  $settings['backdrop']['footnotesButtonLabel'] = t('Insert footnote');
  $settings['backdrop']['footnotesChangedMessage'] = t('The editor content changed while the dialog was open. Please open the footnote dialog again.');
}

/**
 * Implements hook_tinymce_external_plugins().
 */
function footnotes_wysiwyg_tinymce_external_plugins($format) {
  $path = backdrop_get_path('module', 'footnotes_wysiwyg');
  return array(
    'backdropfootnotes' => array(
      'plugin_path' => base_path() . $path . '/tinymce_plugin/plugin.js',
      'icons' => array('backdropfootnotes' => 'footnotes.svg'),
      'variables' => array(
        'footnotesDialogUrl' => _footnotes_wysiwyg_dialog_url($format),
        'footnotesButtonLabel' => t('Insert footnote'),
        'footnotesChangedMessage' => t('The editor content changed while the dialog was open. Please open the footnote dialog again.'),
      ),
      'buttons' => array(
        'backdropfootnotes' => array(
          'icon' => 'backdropfootnotes',
          'tooltip' => t('Insert footnote'),
          'required_tags' => array(),
        ),
      ),
    ),
  );
}

/**
 * Implements hook_ckeditor5_plugins().
 */
function footnotes_wysiwyg_ckeditor5_plugins() {
  return array(
    'backdropFootnotes.Footnotes' => array(
      'library' => array('footnotes_wysiwyg', 'footnotes_wysiwyg.ckeditor5'),
      'buttons' => array(
        'footnotes' => array(
          'label' => t('Insert footnote'),
          'image' => _footnotes_wysiwyg_icon_path(),
          'required_html' => array(),
        ),
      ),
    ),
  );
}

/**
 * Implements hook_library_info().
 */
function footnotes_wysiwyg_library_info() {
  $path = backdrop_get_path('module', 'footnotes_wysiwyg');
  return array(
    'footnotes_wysiwyg.ckeditor5' => array(
      'title' => 'Footnotes integration for CKEditor 5',
      'version' => '1.1.0',
      'js' => array(
        $path . '/ckeditor5_plugin/plugin.js' => array('preprocess' => FALSE),
      ),
      'dependencies' => array(array('ckeditor5', 'ckeditor5')),
    ),
  );
}

/**
 * Implements hook_ckeditor5_config_alter().
 */
function footnotes_wysiwyg_ckeditor5_config_alter(array &$config, $format) {
  $icon_path = _footnotes_wysiwyg_icon_path();
  $config['backdropFootnotes'] = array(
    'dialogUrl' => _footnotes_wysiwyg_dialog_url($format),
    'insertLabel' => t('Insert footnote'),
    // CKEditor 5 ButtonView expects SVG markup, not an image URL.
    'icon' => file_get_contents($icon_path),
    'changedMessage' => t('The editor content changed while the dialog was open. Please open the footnote dialog again.'),
  );
}

/**
 * Implements hook_ckeditor5_upgrade_button_mapping().
 */
function footnotes_wysiwyg_ckeditor5_upgrade_button_mapping() {
  return array('footnotes' => 'footnotes');
}

/**
 * Implements hook_menu().
 */
function footnotes_wysiwyg_menu() {
  $items['editor/dialog/footnotes/%filter_format'] = array(
    'title' => 'Footnotes',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('footnotes_wysiwyg_footnote_editor_form', 3),
    'access callback' => 'filter_dialog_access',
    'access arguments' => array(3, 'footnotes'),
    'theme callback' => 'ajax_base_page_theme',
    'type' => MENU_CALLBACK,
  );
  return $items;
}

/**
 * Builds the shared Backdrop editor dialog (insertion only).
 */
function footnotes_wysiwyg_footnote_editor_form($form, &$form_state, $format) {
  $form_state['format'] = $format;
  if (isset($form_state['input']['dialogOptions']['target']) && is_string($form_state['input']['dialogOptions']['target'])) {
    // Preserve the editor integration's container, limited to a simple ID.
    $target = $form_state['input']['dialogOptions']['target'];
    if (preg_match('/^#[A-Za-z][A-Za-z0-9_-]*$/D', $target)) {
      $form_state['storage']['dialog_selector'] = $target;
    }
  }
  $values = array();
  if (isset($form_state['input']['editor_object']) && is_array($form_state['input']['editor_object'])) {
    $values = $form_state['input']['editor_object'];
  }
  backdrop_set_title(t('Insert footnote'));
  $form['#prefix'] = '<div id="footnotes-editor-dialog-form-wrapper">';
  $form['#suffix'] = '</div>';
  $form['#validate'] = array('footnotes_wysiwyg_footnote_editor_form_validate');
  $form['#submit'] = array();
  $form['footnote_text'] = array(
    '#title' => t('Footnote text'),
    '#type' => 'textarea',
    '#rows' => 5,
    '#required' => TRUE,
    '#default_value' => isset($values['footnote_text']) && is_string($values['footnote_text']) ? $values['footnote_text'] : '',
    '#description' => t('Enter plain text. Line breaks will be replaced with spaces.'),
    '#parents' => array('attributes', 'footnote_text'),
  );
  $form['footnote_value'] = array(
    '#title' => t('Footnote value'),
    '#type' => 'textfield',
    '#maxlength' => 255,
    '#default_value' => isset($values['footnote_value']) && is_string($values['footnote_value']) ? $values['footnote_value'] : '',
    '#description' => t('Optional. Leave empty for automatic numbering, or enter a number or marker such as *. Reusing an existing value adds another reference to the same footnote; the first footnote text is used.'),
    '#parents' => array('attributes', 'footnote_value'),
  );
  $form['actions'] = array('#type' => 'actions');
  $form['actions']['submit'] = array(
    '#type' => 'submit',
    '#value' => t('Save'),
    '#ajax' => array(
      'callback' => 'footnotes_wysiwyg_footnote_editor_form_ajax',
      'event' => 'click',
    ),
  );
  return $form;
}

/**
 * Validates and normalizes the common dialog values for all editors.
 */
function footnotes_wysiwyg_footnote_editor_form_validate($form, &$form_state) {
  $attributes = isset($form_state['values']['attributes']) && is_array($form_state['values']['attributes']) ? $form_state['values']['attributes'] : array();
  $text = isset($attributes['footnote_text']) && is_string($attributes['footnote_text']) ? trim($attributes['footnote_text']) : '';
  $value = isset($attributes['footnote_value']) && is_string($attributes['footnote_value']) ? trim($attributes['footnote_value']) : '';
  if ($text === '') {
    form_set_error('attributes][footnote_text', t('Enter a footnote text.'));
  }
  if (preg_match('~\[/?fn\b|</?fn\b~i', $text)) {
    form_set_error('attributes][footnote_text', t('Footnote text must not contain footnote tags.'));
  }
  if (preg_match('/["<>\[\]\r\n\x00-\x1F\x7F]/', $value)) {
    form_set_error('attributes][footnote_value', t('The footnote value contains invalid characters.'));
  }
  if ($value === '0') {
    form_set_error('attributes][footnote_value', t('Use a value other than 0, or leave the field empty for automatic numbering.'));
  }
  $text = preg_replace('/\r\n|\r|\n/', ' ', $text);
  form_set_value($form['footnote_text'], $text, $form_state);
  form_set_value($form['footnote_value'], $value, $form_state);
}

/**
 * Returns dialog errors, or the standard editorDialogSave and close commands.
 *
 * The core image-dialog error handler has image-specific selectors, so use
 * a Footnotes-specific replacement while keeping the standard save protocol.
 */
function footnotes_wysiwyg_footnote_editor_form_ajax($form, &$form_state) {
  $commands = array();
  if (form_get_errors()) {
    $messages = theme('status_messages');
    $commands[] = ajax_command_remove('.editor-footnote-dialog .messages');
    $commands[] = ajax_command_replace('#footnotes-editor-dialog-form-wrapper', $messages . backdrop_render($form));
  }
  else {
    $selector = isset($form_state['storage']['dialog_selector']) ? $form_state['storage']['dialog_selector'] : '#backdrop-dialog';
    $commands[] = array('command' => 'editorDialogSave', 'values' => $form_state['values']);
    $commands[] = ajax_command_close_dialog($selector);
  }
  return array('#type' => 'ajax', '#commands' => $commands);
}
